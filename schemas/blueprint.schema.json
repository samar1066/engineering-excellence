{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samar1066/engineering-excellence/schemas/blueprint.schema.json",
  "title": "EEP blueprint",
  "type": "object",
  "required": ["name", "description", "core", "authors", "maintainers"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "core": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "slices": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "pillars": {
      "type": "array",
      "items": { "type": "string", "pattern": "^EEP-" }
    },
    "wiring": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "github"],
        "properties": {
          "name": { "type": "string" },
          "github": { "type": "string", "pattern": "^@" }
        },
        "additionalProperties": false
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^@" }
    }
  },
  "additionalProperties": false
}
