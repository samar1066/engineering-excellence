{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samar1066/engineering-excellence/schemas/pack.schema.json",
  "title": "EEP pack manifest",
  "type": "object",
  "required": ["name", "kind", "version", "tier", "source", "detect", "implements", "toolchain", "authors", "maintainers"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "kind": { "enum": ["stack", "platform", "delivery"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "tier": { "enum": [1, 2] },
    "source": { "enum": ["builtin"] },
    "detect": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["file"],
      "properties": { "file": { "type": "string" }, "contains": { "type": "string" } },
      "additionalProperties": false } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "component_dir": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "workdir": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "implements": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^EEP-" } },
    "declines": { "type": "array", "items": {
      "type": "object", "required": ["law", "reason"],
      "properties": { "law": { "type": "string", "pattern": "^EEP-" }, "reason": { "type": "string", "minLength": 10 } } } },
    "toolchain": { "$ref": "./toolchain.schema.json" },
    "authors": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "github"],
      "properties": { "name": { "type": "string" }, "github": { "type": "string", "pattern": "^@" } } } },
    "maintainers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^@" } }
  },
  "additionalProperties": false
}
