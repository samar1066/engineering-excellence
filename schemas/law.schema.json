{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samar1066/engineering-excellence/schemas/law.schema.json",
  "title": "EEP law frontmatter",
  "type": "object",
  "required": ["id", "domain", "title", "version", "status", "maturity", "severity", "applies_to", "authors", "maintainers", "created", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^EEP-[A-Z]{2,5}-[0-9]{2}$" },
    "domain": { "type": "string", "pattern": "^[A-Z]{2,5}$" },
    "title": { "type": "string", "minLength": 10, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "stable", "deprecated", "superseded"] },
    "maturity": { "enum": ["foundational", "standard", "advanced"] },
    "severity": { "enum": ["blocking", "warning", "advisory"] },
    "waivable": { "type": "boolean" },
    "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "authors": { "type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "github"],
      "properties": { "name": { "type": "string" }, "github": { "type": "string", "pattern": "^@" } } } },
    "maintainers": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^@" } },
    "created": { "type": "string", "format": "date" },
    "updated": { "type": "string", "format": "date" },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^EEP-" } }
  },
  "additionalProperties": false
}
