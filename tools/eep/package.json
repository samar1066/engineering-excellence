{
  "name": "engineering-excellence",
  "version": "0.3.0",
  "description": "One command turns any repository into a place where AI coding agents build software the right way: doctrine, golden paths, generated agent instructions, and machine enforced gates for FastAPI, React, TypeScript, containers, AWS CDK, and GitHub Actions",
  "license": "Apache-2.0",
  "author": "Samar Swami (@samar1066)",
  "homepage": "https://github.com/samar1066/engineering-excellence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samar1066/engineering-excellence.git"
  },
  "bugs": {
    "url": "https://github.com/samar1066/engineering-excellence/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "copilot",
    "cursor",
    "agents-md",
    "code-standards",
    "code-quality",
    "golden-path",
    "scaffolding",
    "monorepo",
    "fastapi",
    "react",
    "typescript",
    "aws-cdk",
    "github-actions",
    "ci-cd",
    "tdd",
    "developer-experience"
  ],
  "type": "module",
  "bin": {
    "eep": "./dist/index.js"
  },
  "files": ["dist", "corpus"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepack": "npm run build && node scripts/bundle-corpus.mjs",
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
